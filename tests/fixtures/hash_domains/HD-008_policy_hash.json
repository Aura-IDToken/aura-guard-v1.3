  "input_utf8": "name: finance-v1\nversion: \"1.3.0\"\nrules:\n  # ──────────────────────────────────────────────────────────────────────\n  # Credit card numbers (case-insensitive at the engine level — pattern works\n  # even though the shadow text is lowercased). The Luhn check eliminates the\n  # vast majority of false positives (e.g. 16-digit transaction IDs).\n  # ──────────────────────────────────────────────────────────────────────\n  - id: credit-card\n    pattern: '\\b(?:\\d[ -]*?){13,19}\\b'\n    action: deny\n    score: 1.0\n    validator: luhn\n\n  # Polish IBAN (\"PL\" + 26 digits). After shadow normalization the literal\n  # becomes lowercase \"pl\" — the (?i) wrapper compiled into every rule keeps\n  # the human-readable form valid. The mod-97 validator drops false positives.\n  - id: iban-pl\n    pattern: 'PL[0-9]{26}'\n    action: deny\n    score: 1.0\n    validator: iban\n\n  # Generic IBAN (15-34 char ISO-13616). Mod-97 check enforced.\n  - id: iban-generic\n    pattern: '\\b[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}\\b'\n    action: review\n    score: 0.7\n    validator: iban\n\n  # SWIFT/BIC, only active when the context indicates a finance workload.\n  - id: swift-code\n    pattern: '\\b[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?\\b'\n    action: review\n    score: 0.6\n    conditions:\n      context: 'Finance'\n",
